{
  "name": "bindb",
  "displayName": "BindB — Database IDE",
  "description": "Schema-aware SQL editing and a fast result grid for PostgreSQL, MySQL, SQLite and H2.",
  "version": "0.4.0",
  "publisher": "AzuraLight",
  "author": {
    "name": "AzuraLight"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzuraLight/bindb.git"
  },
  "homepage": "https://github.com/AzuraLight/bindb#readme",
  "bugs": {
    "url": "https://github.com/AzuraLight/bindb/issues"
  },
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "keywords": [
    "database",
    "sql",
    "postgresql",
    "mysql",
    "sqlite",
    "h2",
    "query",
    "database client"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "BindB",
      "properties": {
        "bindb.connections": {
          "type": "array",
          "default": [],
          "description": "Database connections. Passwords are stored in the OS keychain, not here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "driver"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "driver": {
                "type": "string",
                "enum": [
                  "postgres",
                  "mysql",
                  "sqlite",
                  "h2"
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "database": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "SQLite database file, or H2 .mv.db file (file mode)."
              },
              "readOnly": {
                "type": "boolean"
              },
              "ssl": {
                "type": "string",
                "enum": [
                  "disable",
                  "require",
                  "verify"
                ],
                "default": "disable",
                "description": "PostgreSQL / MySQL: require = encrypt without checking the certificate, verify = encrypt and check it."
              },
              "connectTimeout": {
                "type": "number",
                "minimum": 1,
                "maximum": 600,
                "description": "Seconds to wait when connecting (default 10)."
              },
              "comment": {
                "type": "string"
              }
            }
          }
        },
        "bindb.h2.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the H2 JDBC driver (h2-*.jar). BindB runs it in a Java process (Java 11+, JAVA_HOME or java on PATH) only while an H2 connection is open.",
          "scope": "machine"
        },
        "bindb.diagnostics.unresolvedReferences": {
          "type": "boolean",
          "default": true,
          "description": "Warn about tables and columns that are not in the bound connection's loaded metadata (DataGrip's unresolved reference inspection). Only metadata that is already loaded is used; no connection is opened for this."
        },
        "bindb.ddl.showPreviewOfValidScript": {
          "type": "boolean",
          "default": false,
          "description": "Show the migration script before running it when you submit a view DDL (DataGrip: Show preview of valid script when updating source text). When off, a valid script runs right away.",
          "scope": "application"
        },
        "bindb.grid.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "description": "Rows fetched per page in the result grid."
        },
        "bindb.ai.mcpServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run a local MCP server (127.0.0.1, token required) so AI agents — Copilot agent mode, Claude Code, Codex — can read schemas and run read-only queries on BindB connections.",
          "scope": "application"
        },
        "bindb.ai.mcpServer.port": {
          "type": "number",
          "default": 47863,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port of the local MCP server.",
          "scope": "application"
        },
        "bindb.ai.allowWrites": {
          "type": "boolean",
          "default": false,
          "description": "Let AI tools run statements that change data or schema (each one still needs your confirmation; read-only connections are never written).",
          "scope": "application"
        },
        "bindb.ssh.configurations": {
          "type": "array",
          "default": [],
          "description": "SSH configurations shared by data sources (edited from the SSH/SSL tab of the Data Sources panel). Passwords and key passphrases are kept in the OS keychain.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "host",
              "user",
              "auth"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "user": {
                "type": "string"
              },
              "auth": {
                "type": "string",
                "enum": [
                  "password",
                  "key",
                  "agent"
                ]
              },
              "keyFile": {
                "type": "string"
              },
              "parseConfig": {
                "type": "boolean"
              },
              "keepAlive": {
                "type": "number"
              },
              "strictHostKey": {
                "type": "string",
                "enum": [
                  "yes",
                  "acceptNew",
                  "no",
                  "ask"
                ]
              }
            }
          },
          "scope": "application"
        },
        "bindb.dataSourceTemplates": {
          "type": "array",
          "default": [],
          "description": "Data source templates (settings without credentials), managed from the Data Sources panel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bindb",
          "title": "BindB",
          "icon": "media/bindb.svg"
        }
      ]
    },
    "views": {
      "bindb": [
        {
          "id": "bindb.explorer",
          "name": "Database Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bindb.explorer",
        "contents": "No connections yet.\n[Add Connection](command:bindb.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "bindb.addConnection",
        "title": "Add Connection",
        "category": "BindB",
        "icon": "$(add)"
      },
      {
        "command": "bindb.editConnection",
        "title": "Edit Connection",
        "category": "BindB",
        "icon": "$(edit)"
      },
      {
        "command": "bindb.manageConnections",
        "title": "Manage Connections",
        "category": "BindB",
        "icon": "$(settings-gear)"
      },
      {
        "command": "bindb.removeConnection",
        "title": "Remove Connection",
        "category": "BindB",
        "icon": "$(trash)"
      },
      {
        "command": "bindb.revealInExplorer",
        "title": "Reveal in BindB Explorer",
        "category": "BindB"
      },
      {
        "command": "bindb.refresh",
        "title": "Refresh Schema",
        "category": "BindB",
        "icon": "$(refresh)"
      },
      {
        "command": "bindb.disconnect",
        "title": "Disconnect",
        "category": "BindB",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "bindb.openConsole",
        "title": "Open Query Console",
        "category": "BindB",
        "icon": "$(terminal)"
      },
      {
        "command": "bindb.selectConnection",
        "title": "Select Connection for This File",
        "category": "BindB",
        "icon": "$(database)"
      },
      {
        "command": "bindb.runStatement",
        "title": "Run Statement at Cursor",
        "category": "BindB",
        "icon": "$(play)"
      },
      {
        "command": "bindb.cancelQuery",
        "title": "Cancel Running Query",
        "category": "BindB",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bindb.previewTable",
        "title": "Open Table Data",
        "category": "BindB",
        "icon": "$(table)"
      },
      {
        "command": "bindb.add.postgres",
        "title": "PostgreSQL",
        "category": "BindB: Add Connection"
      },
      {
        "command": "bindb.add.mysql",
        "title": "MySQL / MariaDB",
        "category": "BindB: Add Connection"
      },
      {
        "command": "bindb.add.sqlite",
        "title": "SQLite",
        "category": "BindB: Add Connection"
      },
      {
        "command": "bindb.add.h2",
        "title": "H2",
        "category": "BindB: Add Connection"
      },
      {
        "command": "bindb.commit",
        "title": "Commit",
        "category": "BindB",
        "icon": "$(check)"
      },
      {
        "command": "bindb.rollback",
        "title": "Rollback",
        "category": "BindB",
        "icon": "$(discard)"
      },
      {
        "command": "bindb.switchSchema",
        "title": "Switch Schema",
        "category": "BindB",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "bindb.ddl.create",
        "title": "Create DDL Mapping",
        "category": "BindB"
      },
      {
        "command": "bindb.ddl.dump",
        "title": "DDL Mapping: Dump to DDL Data Source",
        "category": "BindB"
      },
      {
        "command": "bindb.ddl.update",
        "title": "DDL Mapping: Update from Data Source",
        "category": "BindB"
      },
      {
        "command": "bindb.ddl.apply",
        "title": "DDL Mapping: Apply to Data Source",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.enableMcp",
        "title": "Enable MCP Server for AI Agents",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.disableMcp",
        "title": "Disable MCP Server for AI Agents",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.setupClaudeCode",
        "title": "Connect Claude Code (MCP)",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.setupCodex",
        "title": "Connect Codex (MCP)",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.copySchema",
        "title": "Copy Schema for AI Chat",
        "category": "BindB"
      },
      {
        "command": "bindb.ai.rotateToken",
        "title": "Regenerate MCP Token",
        "category": "BindB"
      },
      {
        "command": "bindb.runAll",
        "title": "Run All Statements",
        "category": "BindB",
        "icon": "$(run-all)"
      },
      {
        "command": "bindb.virtual.addForeignKey",
        "title": "Add Virtual Foreign Key",
        "category": "BindB"
      },
      {
        "command": "bindb.virtual.addColumn",
        "title": "Add Virtual Column",
        "category": "BindB"
      },
      {
        "command": "bindb.virtual.addView",
        "title": "Add Virtual View",
        "category": "BindB"
      },
      {
        "command": "bindb.virtual.remove",
        "title": "Remove Virtual Object",
        "category": "BindB"
      },
      {
        "command": "bindb.virtual.openFile",
        "title": "Open Virtual Objects File",
        "category": "BindB"
      },
      {
        "command": "bindb.virtual.openView",
        "title": "Open Virtual View",
        "category": "BindB"
      },
      {
        "command": "bindb.queryHistory",
        "title": "Query History",
        "category": "BindB",
        "icon": "$(history)"
      },
      {
        "command": "bindb.clearHistory",
        "title": "Clear Query History",
        "category": "BindB"
      },
      {
        "command": "bindb.introspectionLevel",
        "title": "Introspection Level…",
        "category": "BindB",
        "icon": "$(layers)"
      },
      {
        "command": "bindb.ddl.goToDdl",
        "title": "Go to DDL",
        "category": "BindB",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bindb.ddl.submit",
        "title": "Submit",
        "category": "BindB",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "submenu": "bindb.addMenu",
          "when": "view == bindb.explorer",
          "group": "navigation@1"
        },
        {
          "command": "bindb.manageConnections",
          "when": "view == bindb.explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bindb.openConsole",
          "when": "view == bindb.explorer && viewItem =~ /^connection/",
          "group": "inline@1"
        },
        {
          "command": "bindb.refresh",
          "when": "view == bindb.explorer && viewItem =~ /^connection/",
          "group": "inline@2"
        },
        {
          "command": "bindb.editConnection",
          "when": "view == bindb.explorer && viewItem =~ /^connection/",
          "group": "1_conn@0"
        },
        {
          "command": "bindb.disconnect",
          "when": "view == bindb.explorer && viewItem == connection-open",
          "group": "1_conn@1"
        },
        {
          "command": "bindb.removeConnection",
          "when": "view == bindb.explorer && viewItem =~ /^connection/",
          "group": "9_danger@1"
        },
        {
          "command": "bindb.previewTable",
          "when": "view == bindb.explorer && viewItem =~ /^table/",
          "group": "inline@1"
        },
        {
          "command": "bindb.ddl.goToDdl",
          "when": "view == bindb.explorer && viewItem =~ /^table view$/",
          "group": "3_source@1"
        },
        {
          "command": "bindb.ddl.create",
          "when": "view == bindb.explorer && viewItem =~ /^connection/ && viewItem !~ /mapped/",
          "group": "5_ddl@1"
        },
        {
          "command": "bindb.ddl.dump",
          "when": "view == bindb.explorer && viewItem =~ /mapped/",
          "group": "5_ddl@2"
        },
        {
          "command": "bindb.ddl.update",
          "when": "view == bindb.explorer && viewItem == ddlsource",
          "group": "5_ddl@1"
        },
        {
          "command": "bindb.ddl.apply",
          "when": "view == bindb.explorer && viewItem == ddlsource",
          "group": "5_ddl@2"
        },
        {
          "command": "bindb.editConnection",
          "when": "view == bindb.explorer && viewItem == ddlsource",
          "group": "1_conn@0"
        },
        {
          "command": "bindb.removeConnection",
          "when": "view == bindb.explorer && viewItem == ddlsource",
          "group": "9_danger@1"
        },
        {
          "command": "bindb.refresh",
          "when": "view == bindb.explorer && viewItem == ddlsource",
          "group": "inline@2"
        },
        {
          "command": "bindb.ai.copySchema",
          "when": "view == bindb.explorer && viewItem =~ /^(connection|ddlsource)/",
          "group": "6_ai@1"
        },
        {
          "command": "bindb.virtual.addForeignKey",
          "when": "view == bindb.explorer && viewItem =~ /^table/",
          "group": "7_virtual@1"
        },
        {
          "command": "bindb.virtual.addColumn",
          "when": "view == bindb.explorer && viewItem =~ /^table/",
          "group": "7_virtual@2"
        },
        {
          "command": "bindb.virtual.addView",
          "when": "view == bindb.explorer && viewItem =~ /^(schema|connection)/",
          "group": "7_virtual@1"
        },
        {
          "command": "bindb.virtual.openFile",
          "when": "view == bindb.explorer && viewItem =~ /^connection/",
          "group": "7_virtual@2"
        },
        {
          "command": "bindb.virtual.remove",
          "when": "view == bindb.explorer && viewItem == virtual",
          "group": "9_danger@1"
        },
        {
          "command": "bindb.introspectionLevel",
          "when": "view == bindb.explorer && (viewItem =~ /^connection/ || viewItem == schema)",
          "group": "2_introspect@1"
        }
      ],
      "editor/context": [
        {
          "command": "bindb.revealInExplorer",
          "when": "editorLangId == sql",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "bindb.runStatement",
          "when": "editorLangId == sql && resourceScheme != bindb-ddl",
          "group": "navigation@1"
        },
        {
          "command": "bindb.runAll",
          "when": "editorLangId == sql && resourceScheme != bindb-ddl",
          "group": "navigation@1"
        },
        {
          "command": "bindb.commit",
          "when": "editorLangId == sql && resourceScheme != bindb-ddl",
          "group": "navigation@2"
        },
        {
          "command": "bindb.rollback",
          "when": "editorLangId == sql && resourceScheme != bindb-ddl",
          "group": "navigation@3"
        },
        {
          "command": "bindb.queryHistory",
          "when": "editorLangId == sql && resourceScheme != bindb-ddl",
          "group": "navigation@4"
        },
        {
          "command": "bindb.ddl.submit",
          "when": "resourceScheme == bindb-ddl && resourceQuery != db",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bindb.previewTable",
          "when": "false"
        },
        {
          "command": "bindb.ddl.goToDdl",
          "when": "false"
        },
        {
          "command": "bindb.ddl.submit",
          "when": "resourceScheme == bindb-ddl"
        },
        {
          "command": "bindb.removeConnection",
          "when": "false"
        },
        {
          "command": "bindb.disconnect",
          "when": "false"
        },
        {
          "command": "bindb.add.postgres",
          "when": "false"
        },
        {
          "command": "bindb.add.mysql",
          "when": "false"
        },
        {
          "command": "bindb.add.sqlite",
          "when": "false"
        },
        {
          "command": "bindb.add.h2",
          "when": "false"
        },
        {
          "command": "bindb.ddl.create",
          "when": "false"
        },
        {
          "command": "bindb.ddl.dump",
          "when": "false"
        },
        {
          "command": "bindb.ddl.update",
          "when": "false"
        },
        {
          "command": "bindb.ddl.apply",
          "when": "false"
        },
        {
          "command": "bindb.virtual.addForeignKey",
          "when": "false"
        },
        {
          "command": "bindb.virtual.addColumn",
          "when": "false"
        },
        {
          "command": "bindb.virtual.addView",
          "when": "false"
        },
        {
          "command": "bindb.virtual.remove",
          "when": "false"
        },
        {
          "command": "bindb.virtual.openFile",
          "when": "false"
        },
        {
          "command": "bindb.virtual.openView",
          "when": "false"
        }
      ],
      "bindb.addMenu": [
        {
          "command": "bindb.add.postgres",
          "group": "1_drivers@0"
        },
        {
          "command": "bindb.add.mysql",
          "group": "1_drivers@1"
        },
        {
          "command": "bindb.add.sqlite",
          "group": "1_drivers@2"
        },
        {
          "command": "bindb.add.h2",
          "group": "1_drivers@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bindb.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && resourceScheme != bindb-ddl"
      },
      {
        "command": "bindb.queryHistory",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorLangId == sql"
      }
    ],
    "submenus": [
      {
        "id": "bindb.addMenu",
        "label": "Add Connection",
        "icon": "$(add)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "bindb",
        "label": "BindB"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:java": "node scripts/build-java.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "node --import tsx --test test/*.test.ts",
    "notices": "node scripts/notices.mjs",
    "package": "npm run notices && npm run build -- --production && vsce package --no-dependencies",
    "test:integration": "npm run build && vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "1.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.101.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode-elements/react-elements": "^2.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, BindB ignores connections, the H2 jar path and SSH configurations defined in the workspace settings, because connecting can run programs (H2 java options, Before connection tasks) and SQL (startup scripts).",
      "restrictedConfigurations": [
        "bindb.connections",
        "bindb.h2.jarPath",
        "bindb.ssh.configurations",
        "bindb.dataSourceTemplates"
      ]
    }
  }
}

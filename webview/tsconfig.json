{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/shared/**/*.ts",
    "../src/core/connectionDraft.ts",
    "../src/drivers/types.ts",
    "../src/core/editing.ts",
    "../src/core/gridQuery.ts",
    "../src/language/splitter.ts",
    "../src/language/tokenizer.ts"
  ]
}
